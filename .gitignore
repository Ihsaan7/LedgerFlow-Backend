# Dependencies
**/node_modules/

# Build output
**/dist/
**/build/
**/out/

# Test and coverage output
**/coverage/
**/.nyc_output/
**/test-results/

# Environment and local configuration
**/.env
**/.env.*
!**/.env.example

# Logs and temporary files
**/*.log
**/logs/
**/tmp/
**/temp/

# Runtime data
**/*.pid
**/*.seed
**/*.pid.lock

# TypeScript and tooling caches
**/.eslintcache
**/.stylelintcache
**/.tsbuildinfo
**/.cache/
**/.vite/

# IDE settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/tasks.json
!.vscode/launch.json
.idea/

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

